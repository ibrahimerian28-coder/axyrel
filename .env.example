# Axyrel application configuration
AXYREL_ENV=development
AXYREL_APP_NAME=Axyrel
AXYREL_APP_VERSION=1.0.0
AXYREL_API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/axyrel

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Task 45 — Streamlit -> FastAPI
AXYREL_UI_API_ENABLED=true
AXYREL_API_BASE_URL=http://127.0.0.1:8000
AXYREL_API_TOKEN=
# Deprecated: tenant context is now derived from the authenticated API user.
AXYREL_COMPANY_ID=
AXYREL_API_TIMEOUT_SECONDS=20
